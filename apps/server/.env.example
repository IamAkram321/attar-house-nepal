PORT=3000
NODE_ENV=development
# New isolated Supabase project — paste YOUR connection string here.
# Example shape only (no real credentials in this file):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
SESSION_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Optional extra origins, comma-separated:
# ALLOWED_ORIGINS=https://your-store.vercel.app
# Cookie domain for production only (leave empty for localhost):
# COOKIE_DOMAIN=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Isolated Cloudinary folders (new account or new folders recommended):
UPLOAD_FOLDER=ayesha-fragrances/uploads
PAYMENT_PROOF_FOLDER=ayesha-fragrances/payment-proofs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
RECAPTCHA_SECRET_KEY=
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ENABLE_MOCK_PAYMENT=true
